msgstr "Project-Id-Version: luci-app-tailscale-community-ru 1.1.0\nLanguage: ru\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\nContent-Transfer-Encoding: 8bit\nPlural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "%s failed"
msgstr "Не удалось выполнить: %s"

msgid "(Experimental) Reduce Memory Usage"
msgstr "Снизить расход памяти (экспериментально)"

msgid "1. Enable \"Advertise Exit Node\"."
msgstr "1. Включите «Разрешить выход в интернет через этот роутер»."

msgid "1. Select \"Accept Routes\" (to access remote devices)."
msgstr "1. Включите «Принимать маршруты», чтобы подключаться к устройствам в удалённых подсетях."

msgid "2. Click \"Auto Configure Firewall\" (it forwards Tailscale traffic to WAN)."
msgstr "2. Нажмите «Настроить межсетевой экран», чтобы разрешить выход из Tailscale в интернет."

msgid "2. In \"Advertise Routes\", select your local subnet (to allow remote devices to access this LAN)."
msgstr "2. В поле «Предоставить доступ к подсетям» выберите свою локальную подсеть, чтобы сделать её доступной через Tailscale."

msgid "3. Click \"Auto Configure Firewall\" (to allow traffic forwarding)."
msgstr "3. Нажмите «Настроить межсетевой экран», чтобы разрешить пересылку трафика."

msgid "3. In the Tailscale admin console, edit this device under the route settings and approve it as an Exit Node."
msgstr "3. Откройте настройки маршрутов этого устройства в панели Tailscale и разрешите использовать его для выхода в интернет."

msgid "4. On the client, set this device as its exit node."
msgstr "4. На телефоне или компьютере выберите это устройство для выхода в интернет."

msgid "Accept Routes"
msgstr "Принимать маршруты"

msgid "Account Settings"
msgstr "Аккаунт"

msgid "Advertise Exit Node"
msgstr "Разрешить выход в интернет через этот роутер"

msgid "Advertise Routes"
msgstr "Предоставить доступ к подсетям"

msgid "Advertise subnet routes behind this device. Select from the detected subnets below or enter custom routes (comma-separated)."
msgstr "Выберите подсети, доступ к которым нужно предоставить через этот роутер, или укажите их через запятую."

msgid "Allow LAN Access"
msgstr "Сохранить доступ к локальной сети"

msgid "Allow accepting routes announced by other nodes."
msgstr "Подключаться к подсетям, доступ к которым предоставляют другие устройства Tailscale."

msgid "Allow connecting to this device through the SSH function of Tailscale."
msgstr "Разрешить подключение к этому роутеру через Tailscale SSH."

msgid "Another firewall reload is already running"
msgstr "Межсетевой экран уже перезагружается. Дождитесь завершения."

msgid "Applying changes..."
msgstr "Применяем настройки…"

msgid "Are you sure you want to log out?"
msgstr "Выйти из Tailscale?"

msgid "Auto Configure Firewall"
msgstr "Настроить межсетевой экран"

msgid "Cancel"
msgstr "Отмена"

msgid "Click to Log out account on this device."
msgstr "Выйти из учётной записи на этом устройстве."

msgid "Click to get a login URL for this device."
msgstr "Получить ссылку, чтобы подключить это устройство к Tailscale."

msgid "Collecting data ..."
msgstr "Сбор данных…"

msgid "Configuration committed, reloading network and firewall. This can take a moment."
msgstr "Настройки сохранены. Сеть и межсетевой экран перезагружаются. Подождите."

msgid "Configuring firewall"
msgstr "Настраиваем межсетевой экран…"

msgid "Confirm Logout"
msgstr "Подтверждение выхода"

msgid "Connection Info"
msgstr "Подключение"

msgid "Controls how Tailscale DNS is handled."
msgstr "Выберите, как обрабатывать DNS-запросы Tailscale."

msgid "Could not open a new tab. Please check if your browser or an extension blocked the pop-up."
msgstr "Не удалось открыть вкладку. Проверьте блокировку всплывающих окон."

msgid "Custom Login Server"
msgstr "Свой сервер авторизации"

msgid "Custom Login Server Auth Key"
msgstr "Ключ авторизации"

msgid "DNS Mode"
msgstr "Режим DNS"

msgid "Daemon MTU"
msgstr "MTU туннеля"

msgid "Daemon Settings"
msgstr "Настройки службы"

msgid "Declare this device as an Exit Node."
msgstr "Чтобы другие устройства могли выходить в интернет через этот роутер, разрешите его использование в панели Tailscale."

msgid "Devices List"
msgstr "Устройства"

msgid "Disable Firewall Configuration"
msgstr "Отключить автоматические правила Tailscale"

msgid "Disable MagicDNS"
msgstr "Отключить MagicDNS"

msgid "Disable SNAT"
msgstr "Отключить SNAT"

msgid "Disable Source NAT (SNAT) for traffic to advertised routes. Most users should leave this unchecked."
msgstr "Сохраняет исходные IP-адреса при обращении к доступным через роутер подсетям. Обычно эту опцию включать не нужно."

msgid "Disable Tailscale netfilter auto-configuration (--netfilter-mode=off)."
msgstr "Запретить Tailscale автоматически создавать правила межсетевого экрана."

msgid "Disabled"
msgstr "Отключено"

msgid "Disabled: system DNS only."
msgstr "Отключено: только системный DNS."

msgid "Disconnect from Tailscale and expire current node key."
msgstr "Отключиться от Tailscale и аннулировать ключ узла."

msgid "Empty reply from server"
msgstr "Сервер вернул пустой ответ."

msgid "Enable Peer Relay"
msgstr "Ретранслировать соединения"

msgid "Enable Tailscale SSH"
msgstr "Разрешить подключение по SSH"

msgid "Enable Tailscale Service"
msgstr "Включить службу Tailscale"

msgid "Enable Web Interface"
msgstr "Включить веб-интерфейс Tailscale"

msgid "Enable or disable the Tailscale service. When disabled, the service will be stopped and the process will be killed."
msgstr "Включает или выключает Tailscale. При выключении останавливает службу."

msgid "Enable this device as a Peer Relay server. Requires a public IP and an UDP port open on the router."
msgstr "Позволяет передавать соединения других устройств Tailscale через этот роутер. Нужны публичный IP-адрес и открытый UDP-порт."

msgid "Enabled"
msgstr "Включено"

msgid "Enabling this option can reduce memory usage, but it may sacrifice some performance (set GOGC=10)."
msgstr "Снижает потребление памяти, но может ухудшить производительность."

msgid "Error"
msgstr "Ошибка"

msgid "Error applying settings: %s"
msgstr "Не удалось применить настройки. %s"

msgid "Error caching DERP region map: %s"
msgstr "Ошибка кэширования карты DERP: %s"

msgid "Error fetching DERP region map: %s"
msgstr "Ошибка загрузки карты DERP: %s"

msgid "Error reading cached DERP region map: %s"
msgstr "Ошибка чтения кэша карты DERP: %s"

msgid "Error saving settings: %s"
msgstr "Не удалось сохранить настройки. %s"

msgid "Essential configuration for Subnet Routing (Site-to-Site) and Exit Node features."
msgstr "Настраивает пересылку трафика для доступа к подсетям и выхода в интернет через этот роутер."

msgid "Exit Node"
msgstr "Выход в интернет"

msgid "Expose a web interface on port 5252 for managing this node over Tailscale."
msgstr "Открыть веб-интерфейс на порту 5252 для управления узлом через Tailscale."

msgid "Failed to configure firewall: %s"
msgstr "Не удалось настроить межсетевой экран: %s"

msgid "Failed to get login URL. You may close this tab."
msgstr "Не удалось получить ссылку для входа. Эту вкладку можно закрыть."

msgid "Failed to get login URL: %s"
msgstr "Не удалось получить ссылку для входа: %s"

msgid "Failed to get login URL: Invalid response from server."
msgstr "Не удалось получить ссылку для входа. Не удалось обработать ответ сервера."

msgid "Failed to load logs: %s"
msgstr "Не удалось загрузить журнал: %s"

msgid "Failed to save settings: %s"
msgstr "Не удалось сохранить настройки. %s"

msgid "Filter peers by name, IP, or OS..."
msgstr "Найти по имени, IP-адресу или ОС…"

msgid "Filter:"
msgstr "Поиск:"

