msgstr "РАБОТАЕТ"

msgid "RX"
msgstr "Приём"

msgid "Refresh"
msgstr "Обновить"

msgid "Reloading firewall..."
msgstr "Перезагружаем межсетевой экран…"

msgid "Requesting Login URL..."
msgstr "Получаем ссылку для входа…"

msgid "Requesting Tailscale login URL... Please wait."
msgstr "Получаем ссылку для входа в Tailscale. Подождите."

msgid "Select an exit node from the list. If enabled, Allow LAN Access is enabled implicitly."
msgstr "Выберите устройство для выхода в интернет. Доступ к локальной сети включится автоматически."

msgid "Select the firewall backend for Tailscale to use. Requires service restart to take effect."
msgstr "Выберите механизм межсетевого экрана для Tailscale. После изменения перезапустите службу."

msgid "Service Status"
msgstr "Состояние службы"

msgid "Set a custom MTU for the Tailscale daemon. Leave blank to use the default value."
msgstr "Укажите MTU туннеля Tailscale. Оставьте поле пустым, чтобы использовать стандартное значение."

msgid "Settings"
msgstr "Настройки"

msgid "Shields Up"
msgstr "Блокировать входящие подключения"

msgid "Status"
msgstr "Статус"

msgid "Subnet routing is enabled, but IP forwarding is disabled. Check that IP forwarding is enabled on your machine."
msgstr "Настроены маршруты к подсетям, но пересылка IP-пакетов отключена. Включите её на роутере."

msgid "Successfully logged out."
msgstr "Выход выполнен."

