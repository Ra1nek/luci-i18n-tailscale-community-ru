msgstr "Имя устройства"

msgid "How to enable Exit Node?"
msgstr "Как разрешить выход в интернет через этот роутер?"

msgid "How to enable Site-to-Site?"
msgstr "Как соединить локальные сети через Tailscale?"

msgid "If the timeout is displayed, you can refresh the page and click Login again."
msgstr "Если время ожидания истекло, обновите страницу и снова нажмите «Войти»."

msgid "If you are using custom login server but not providing an Auth Key, will redirect to the login page without pre-filling the key."
msgstr "Если ключ не указан, откроется страница входа на указанный сервер."

msgid "Invalid Date"
msgstr "Неверная дата"

msgid "Invalid response from server."
msgstr "Не удалось обработать ответ сервера."

msgid "It automatically creates the tailscale interface, sets up firewall zones for LAN <-> Tailscale forwarding,"
msgstr "Создаёт интерфейс tailscale и разрешает обмен трафиком между локальной сетью и Tailscale,"

msgid "It creates the tailscale interface, adds it to a firewall zone, and sets up forwarding between LAN and Tailscale, plus Tailscale to WAN."
msgstr "Создаёт интерфейс tailscale, добавляет его в зону межсетевого экрана и разрешает обмен трафиком между локальной сетью и Tailscale, а также выход из Tailscale в интернет."

msgid "Just now"
msgstr "Только что"

msgid "LOGGED OUT"
msgstr "ВХОД НЕ ВЫПОЛНЕН"

msgid "Last Seen"
msgstr "Последняя активность"

