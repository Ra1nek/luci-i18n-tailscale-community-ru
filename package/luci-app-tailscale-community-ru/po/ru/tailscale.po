msgstr "Через OpenWrt"

msgid "OpenWrt Forward: MagicDNS via dnsmasq forwarding.(Only support ts.net)"
msgstr "OpenWrt перенаправляет запросы к именам устройств Tailscale. Поддерживаются только имена в домене ts.net."

msgid "Operation"
msgstr "Действие"

msgid "Optional: Specify a custom control server URL (e.g., a Headscale instance, %s)."
msgstr "При необходимости укажите адрес своего сервера авторизации, например Headscale (%s)."

msgid "Optional: Specify a custom control server URL (e.g., a Headscale instance, https://example.com)."
msgstr "При необходимости укажите адрес своего сервера авторизации, например Headscale (https://example.com)."

msgid "Optional: Specify an authentication key for the custom control server. Leave blank if not required."
msgstr "Укажите ключ авторизации своего сервера, если он требуется."

msgid "Peer Relay Port"
msgstr "Порт ретрансляции"

msgid "Please use the login button in the settings below to authenticate."
msgstr "Нажмите «Войти» в настройках ниже, чтобы подключить устройство к Tailscale."

msgid "Please wait."
msgstr "Подождите."

