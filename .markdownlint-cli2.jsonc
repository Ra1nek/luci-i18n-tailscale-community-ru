{
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**", "artifacts/**", "tests/fixtures/**"],
  "config": {
    "default": true,
    "MD013": false,
    "MD033": {
      "allowed_elements": ["p", "img", "h1", "strong", "br", "a", "details", "summary"]
    },
    "MD041": false,
    "MD060": false
  }
}
